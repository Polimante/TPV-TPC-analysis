/* =================================================================
   TPV/TPC — Light Theme  (Fusion base)
   ================================================================= */

/* --- Window ---- */
QMainWindow {
    background-color: #f4f6f8;
}

/* --- Widgets base ---- */
QWidget {
    font-family: "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #212121;
    background-color: transparent;
}

/* ---- Panels que precisam de fundo ---- */
QMainWindow > QWidget,
QDialog > QWidget {
    background-color: #f4f6f8;
}

/* ---- Group boxes ---- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #c2ccd6;
    border-radius: 7px;
    margin-top: 26px;
    padding: 10px 10px 10px 10px;
    font-weight: bold;
    font-size: 10pt;
    color: #37474f;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 5px;
    padding: 2px 8px;
    background-color: #f4f6f8;
    border-radius: 4px;
    color: #455a64;
    font-weight: bold;
}

/* ---- Standard buttons ---- */
QPushButton {
    background-color: #eceff1;
    border: 1px solid #b0bec5;
    border-radius: 5px;
    padding: 5px 16px;
    color: #37474f;
    min-height: 26px;
    font-size: 10pt;
}

QPushButton:hover   { background-color: #dde4ea; border-color: #78909c; }
QPushButton:pressed { background-color: #c8d4dc; border-color: #546e7a; }
QPushButton:disabled {
    background-color: #e8ecf0;
    color: #aab4be;
    border-color: #d0d8e0;
}

/* ---- Text inputs ---- */
QLineEdit {
    border: 1px solid #b0bec5;
    border-radius: 5px;
    padding: 5px 8px;
    background-color: #ffffff;
    color: #212121;
    selection-background-color: #1565c0;
    selection-color: #ffffff;
    min-height: 26px;
}

QLineEdit:focus    { border: 1.5px solid #1565c0; }
QLineEdit:disabled { background-color: #f4f6f8; color: #9e9e9e; }

/* ---- List widget ---- */
QListWidget {
    border: 1px solid #c2ccd6;
    border-radius: 5px;
    background-color: #ffffff;
    outline: none;
    alternate-background-color: #f8fafb;
}

QListWidget::item {
    padding: 3px 4px;
    border: none;
}

QListWidget::item:selected {
    background-color: #e3f2fd;
    color: #212121;
}

QListWidget::item:hover:!selected {
    background-color: #f0f7ff;
}

/* ---- Radio buttons ---- */
QRadioButton {
    spacing: 8px;
    color: #37474f;
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

/* ---- Checkboxes ---- */
QCheckBox {
    spacing: 6px;
    color: #37474f;
    background: transparent;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

/* ---- Status bar ---- */
QStatusBar {
    background-color: #eceff1;
    color: #546e7a;
    border-top: 1px solid #c2ccd6;
    padding: 2px 10px;
    font-size: 9pt;
}

QStatusBar QLabel {
    background: transparent;
    color: #546e7a;
    padding: 0;
}

/* ---- Labels ---- */
QLabel {
    background-color: transparent;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    border: none;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #b0bec5;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #b0bec5;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

/* ---- Tooltips ---- */
QToolTip {
    background-color: #37474f;
    color: #ffffff;
    border: none;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 9pt;
}

/* ---- Separador vertical entre painéis ---- */
QFrame#panel_sep {
    color: #c2ccd6;
    background-color: #c2ccd6;
    max-width: 1px;
    border: none;
}

/* ---- Separador horizontal nas conexões ---- */
QFrame#conn_sep {
    color: #e8edf2;
    background-color: #e8edf2;
    max-height: 1px;
    border: none;
    margin: 0 8px;
}

/* ---- ComboBox ---- */
QComboBox {
    border: 1px solid #b0bec5;
    border-radius: 5px;
    padding: 4px 8px;
    background-color: #ffffff;
    color: #212121;
    min-height: 26px;
}
QComboBox:focus    { border: 1.5px solid #1565c0; }
QComboBox:disabled { background-color: #f4f6f8; color: #9e9e9e; border-color: #d0d8e0; }
QComboBox::drop-down { border: none; width: 22px; }

/* dropdown list that opens when a QComboBox is clicked */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #c2ccd6;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
    outline: none;
    padding: 2px 0;
}

/* ---- SpinBox ---- */
QSpinBox, QDoubleSpinBox {
    border: 1px solid #b0bec5;
    border-radius: 5px;
    padding: 4px 8px;
    background-color: #ffffff;
    color: #212121;
    min-height: 26px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border: 1.5px solid #1565c0; }
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #f4f6f8;
    color: #9e9e9e;
    border-color: #d0d8e0;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    width: 18px;
}

/* ---- Menus (right-click context menus, including pyqtgraph plots) ---- */
QMenu {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #c2ccd6;
    border-radius: 6px;
    padding: 4px 0;
}
QMenu::item {
    padding: 5px 28px 5px 18px;
    background: transparent;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #e3f2fd;
    color: #212121;
}
QMenu::item:disabled { color: #9e9e9e; }
QMenu::separator {
    height: 1px;
    background: #e0e6eb;
    margin: 3px 10px;
}
QMenu::indicator { width: 14px; height: 14px; margin-left: 4px; }
